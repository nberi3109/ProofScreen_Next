# ---------------------------------------------------------------------------
# ProofScreen frontend — environment
#
# The backend is a separate app on a separate deploy. This file is the only
# thing that connects them.
# ---------------------------------------------------------------------------

# Where the FastAPI backend is reachable FROM THE NEXT SERVER — not from the
# browser. Deliberately not NEXT_PUBLIC_: every backend call in this app runs
# in a Server Component or Server Action, so this value is never sent to the
# client and the API can live on an internal hostname with no public ingress.
#
# In Docker Compose this is the service name, e.g. http://api:8000.
PROOFSCREEN_API_URL=http://127.0.0.1:8000

# Server Actions compile to public HTTP endpoints, and this app has no
# authentication yet. Writes stay off until a deployment opts in, so a public
# preview build cannot be used to onboard candidates or record hiring
# decisions. Set to true locally; leave unset in any shared deployment until
# lib/api/actions.ts -> requireWriteAccess() does a real session check.
PROOFSCREEN_ENABLE_WRITES=true

# The simulator drives a session without WhatsApp, through the backend's
# /api/dev/* routes. Every row it creates is Channel.simulated, which the
# backend's contract calls "never a real candidate". Separate switch because
# these actions also include a destructive reset.
# Requires ENABLE_DEV_ENDPOINTS=true on the backend as well.
PROOFSCREEN_ENABLE_DEV_ACTIONS=true
